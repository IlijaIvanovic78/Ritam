{
  "name": "ritam",
  "version": "1.0.0",
  "private": true,
  "description": "Ritam — dnevni plan u blokovima, zadaci i beleške.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch --disable-warning=ExperimentalWarning server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "typecheck": "tsc -p tsconfig.web.json && tsc -p tsconfig.server.json",
    "test": "node --test --disable-warning=ExperimentalWarning \"shared/*.test.ts\" \"server/*.test.ts\"",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.3"
  }
}
