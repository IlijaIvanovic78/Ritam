# Ritam — kopiraj ovaj fajl u .env i popuni vrednosti.
#   cp .env.example .env
#
# Vrednosti piši u jednostrukim navodnicima, npr. APP_PASSWORD='Kx9$mQ2#tz'.
# Bez navodnika Docker Compose menja znak $ (i ono iza njega), pa prava lozinka ne bi radila.
# Lozinka ne sme da sadrži jednostruki navodnik (').

# Lozinka za prijavu u aplikaciju (obavezno). Izaberi dugačku lozinku.
APP_PASSWORD=''

# Tajni ključ za potpis sesije (obavezan).
# Generiši sa: openssl rand -hex 32
# Promena APP_PASSWORD ili SESSION_SECRET odjavljuje sve uređaje (posle izmene: docker compose up -d).
SESSION_SECRET=''

