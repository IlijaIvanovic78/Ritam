# Ritam — kopiraj ovaj fajl u .env i popuni vrednosti.
#   cp .env.example .env
#
# Vrednosti piši u jednostrukim navodnicima, npr. SESSION_SECRET='…'.
# Bez navodnika Docker Compose menja znak $ (i ono iza njega), pa prava vrednost ne bi radila.
# Vrednost ne sme da sadrži jednostruki navodnik (').
#
# Prijava je samo nalogom (email + lozinka): otvori aplikaciju i izaberi "Napravi nalog". Posebna lozinka ili
# kod aplikacije (nekadašnji APP_PASSWORD) više ne postoji.

# Tajni ključ za potpis access tokena (obavezan, bar 32 znaka — kraći server prihvata uz upozorenje).
# Generiši sa: openssl rand -hex 32
# Svako ko ima nalog dobija token potpisan ovim ključem: kratak ili rečnički ključ može da pogađa offline i
# onda lažira tokene za druge naloge.
# Promena ne odjavljuje uređaje (sesije su u bazi). Sve ostale uređaje odjavljuje promena lozinke naloga
# (Podešavanja → Nalog → Promeni lozinku).
SESSION_SECRET=''

# Opciono — ko može da napravi nov nalog (docker-compose.yml ih prosleđuje):
#   open   — svako ko otvori aplikaciju, samo email + lozinka (podrazumevano)
#   closed — niko; postojeći nalozi se normalno prijavljuju. Kad napraviš svoje naloge, ovo drži aplikaciju
#            privatnom (pa `docker compose up -d`). Preporučeno za lični ili porodični server na internetu, čim
#            nalozi postoje: uz `open` svako ko nađe sajt može da napravi nalog i čuva podatke na serveru.
#   code   — samo ko zna SIGNUP_CODE (unosi ga uz email i lozinku pri registraciji)
# SIGNUP='closed'
# Kod za registraciju, samo uz SIGNUP='code' (dugačak, nasumičan; NIJE lozinka za prijavu).
# SIGNUP_CODE=''
