# Ritam — kopiraj ovaj fajl u .env i popuni vrednosti.
#   cp .env.example .env
#
# Vrednosti piši u jednostrukim navodnicima, npr. APP_PASSWORD='Kx9$mQ2#tz'.
# Bez navodnika Docker Compose menja znak $ (i ono iza njega), pa prava vrednost ne bi radila.
# Vrednost ne sme da sadrži jednostruki navodnik (').

# Kod za registraciju naloga (obavezno). NIJE lozinka za prijavu: prijavljuješ se email-om i lozinkom svog
# naloga. Nalog može da napravi samo ko zna ovaj kod; PRVI nalog preuzima sve podatke iz verzije bez naloga.
# Izaberi dugačak, nasumičan kod. Promena koda nikog ne odjavljuje.
APP_PASSWORD=''

# Tajni ključ za potpis access tokena (obavezan, bar 32 znaka — kraći server prihvata uz upozorenje).
# Generiši sa: openssl rand -hex 32
# Svako ko ima nalog dobija token potpisan ovim ključem: kratak ili rečnički ključ može da pogađa offline i
# onda lažira tokene za druge naloge.
# Promena ne odjavljuje uređaje (sesije su u bazi). Sve ostale uređaje odjavljuje promena lozinke naloga
# (Podešavanja → Nalog → Promeni lozinku).
SESSION_SECRET=''

# Opciono — docker-compose.yml ih ne prosleđuje; ako ih koristiš, dodaj ih i u njegov `environment`.
# SIGNUP: code (podrazumevano kad postoji kod) | open (svako može da napravi nalog) | closed (bez novih naloga).
# Kad napraviš svoje naloge, SIGNUP=closed zatvara registraciju.
# SIGNUP='closed'
# SIGNUP_CODE: kod za registraciju umesto APP_PASSWORD.
# SIGNUP_CODE=''
